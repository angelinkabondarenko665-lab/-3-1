<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа №1. Вариант 4" Height="500" Width="800">
    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" Click="Save_Click"/>
                <MenuItem Header="Открыть" Click="Open_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Массив">
                <MenuItem Header="Заполнить" Click="Fill_Click"/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
                <Separator/>
                <MenuItem Header="Вычислить" Click="Calc_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Основная область -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ввод количества -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Количество элементов:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCount" Width="80" Margin="10,0,0,0" Text="10"/>
                <TextBlock Text="Диапазон:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBox x:Name="txtRange" Width="80" Margin="10,0,0,0" Text="100"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5">
                <Button Content="Заполнить" Width="100" Margin="0,0,5,0" Click="Fill_Click"/>
                <Button Content="Очистить"  Width="100" Margin="0,0,5,0" Click="Clear_Click"/>
                <Button Content="Сохранить" Width="100" Margin="0,0,5,0" Click="Save_Click"/>
                <Button Content="Открыть"   Width="100" Margin="0,0,5,0" Click="Open_Click"/>
                <Button Content="Вычислить" Width="100" Margin="0,0,5,0" Click="Calc_Click"/>
                <Button Content="Выход"     Width="100" Click="Exit_Click"/>
                <Button Content="О программе" Width="120" Margin="5,0,0,0" Click="About_Click"/>
            </StackPanel>

            <!-- Исходный массив -->
            <TextBlock Grid.Row="2" Text="Исходный массив:" FontWeight="Bold" Margin="0,5,0,0"/>
            <DataGrid Grid.Row="2" x:Name="dgInput" AutoGenerateColumns="True"
                      Margin="0,25,0,5" IsReadOnly="False"/>

            <!-- Результат -->
            <TextBlock Grid.Row="4" Text="Результат (√x для чисел &gt; 0):" FontWeight="Bold" Margin="0,5,0,0"/>
            <DataGrid Grid.Row="4" x:Name="dgResult" AutoGenerateColumns="True"
                      Margin="0,25,0,5" IsReadOnly="True"/>
        </Grid>
    </DockPanel>
</Window>